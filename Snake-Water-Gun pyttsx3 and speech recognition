import pyttsx3
import speech_recognition as sr
import random

# Initialize text-to-speech engine
engine = pyttsx3.init('sapi5')
voices = engine.getProperty('voices')
engine.setProperty('voice', voices[0].id)

def speak(text):
    """Speak the provided text."""
    engine.say(text)
    engine.runAndWait()

def take_command():
    """Listen to the user's voice command and return the recognized text."""
    r = sr.Recognizer()
    with sr.Microphone() as source:
        print("Listening...")
        r.pause_threshold = 1
        try:
            audio = r.listen(source, timeout=5, phrase_time_limit=5)
            print("Recognizing...")
            query = r.recognize_google(audio, language='en-in')
            print(f"User said: {query}")
            return query.lower()
        except sr.UnknownValueError:
            print("Didn't catch that. Please try again.")
            speak("I didn't understand that. Please try again.")
            return None
        except sr.RequestError:
            print("Speech recognition service is unavailable.")
            speak("Sorry, the speech recognition service is unavailable.")
            return None
        except Exception as e:
            print(f"Error: {e}")
            speak("Something went wrong. Please try again.")
            return None

if __name__ == "__main__":
    speak("Welcome to the Snake, Water, Gun Game!")
    speak("I am Jarvis, and I will play against you.")
    speak("Please tell me your name.")

    name = None
    while not name:
        name = take_command()
        if not name:
            speak("I didn't catch your name. Please say it again.")

    speak(f"Hello {name}, let's start the game!")
    choices = ["python", "water", "ak 47"]
    user_score = 0
    jarvis_score = 0
    total_chances = 5

    for chance in range(1, total_chances + 1):
        jarvis_choice = random.choice(choices)
        speak(f"Chance {chance}. What's your choice? Python, Water, or AK-47?")
        user_choice = None
        while not user_choice:
            user_choice = take_command()
            if user_choice not in choices:
                speak("Invalid choice. Please say Python, Water, or AK-47.")
                user_choice = None

        print(f"Jarvis chose: {jarvis_choice}")
        speak(f"My choice is {jarvis_choice}.")

        # Game logic
        if user_choice == jarvis_choice:
            speak("It's a tie! No points awarded.")
        elif (user_choice == "python" and jarvis_choice == "water") or \
             (user_choice == "water" and jarvis_choice == "ak 47") or \
             (user_choice == "ak 47" and jarvis_choice == "python"):
            user_score += 1
            speak("You won this round!")
        else:
            jarvis_score += 1
            speak("You lost this round!")

        print(f"{name}'s Score: {user_score} | Jarvis's Score: {jarvis_score}\n")

    # Final Results
    speak("The game is over. Calculating results...")
    if user_score > jarvis_score:
        print("CONGRATULATIONS! YOU WON THE GAME!")
        speak("Congratulations! You are the winner!")
    elif user_score < jarvis_score:
        print("OOPS! YOU LOST THE GAME!")
        speak("Oops! I won the game. Better luck next time!")
    else:
        print("IT'S A TIE!")
        speak("It's a tie! Well played!")

    print("Thank you for playing!")
    speak("Thank you for playing! Goodbye!")
